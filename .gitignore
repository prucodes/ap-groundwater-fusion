__pycache__/
.pytest_cache/
.venv/
*.pyc
.DS_Store
app/.next/
app/node_modules/
app/out/
app/*.tsbuildinfo
node_modules/

# Backups, logs, and locally generated model binaries (regenerated by the pipeline)
*.bak
*.log
phase3_levels/models/*.joblib
phase3_levels/**/*.log

# Raw bulk source downloads — regenerable via the fetch_*/submit_* scripts.
# Multi-GB InSAR products, IMD NetCDF rainfall, CGWB groundwater archive: never version.
phase3_levels/insar/products/
phase3_levels/insar/unz/
phase3_levels/imd/
phase3_levels/cgwb_sy/

# Local bulky source downloads should be documented in data/source_manifest.csv.
# Regenerable rasters (re-fetch via the fetch_* scripts) — don't version binaries.
data/raw/chirps/*
data/raw/**/*.tif
data/raw/**/*.nc
data/raw/nasa/*
!data/raw/nasa/.gitkeep
!data/raw/nasa/grace_da_download_manifest.csv
!data/raw/nasa/grace_da/
!data/raw/nasa/grace_da/current/
data/raw/nasa/grace_da/current/*
!data/raw/nasa/grace_da/current/download_manifest.csv

# Playwright artifacts (regenerated by `npm run test:layout`)
app/playwright-report/
app/test-results/

# Rendered video and its fetched NASA stills. The generator rebuilds both, and
# a 8 MB MP4 regenerated on every data refresh does not belong in git history.
dist/
.video-python/
app/public/films/monsoon/voice-*.mp3
app/public/films/monsoon/voice-*.sha256
app/public/films/monsoon/voice-*.jsonl

# IMD API responses: cached privately until IMD usage rules are confirmed for publishing.
data/private/

# AI Living Labs data lake extracts: fetched locally, never committed
data/raw/datalake/
